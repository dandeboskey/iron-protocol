# Mobile app environment variables (all must be prefixed with EXPO_PUBLIC_)
#
# EXPO_PUBLIC_API_BASE — URL where the Next.js backend is reachable.
#   iOS simulator: http://localhost:3000/api
#   Real iPhone on Wi-Fi: http://<your-mac-LAN-IP>:3000/api
#   Production: https://your-domain.com/api
EXPO_PUBLIC_API_BASE=http://localhost:3000/api

# iOS OAuth client ID from Google Cloud Console → Credentials.
# Must be an "iOS" type client bound to the bundle id com.danieldeboskey.ironprotocol
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxx.apps.googleusercontent.com

# The existing web client ID. Passed to expo-auth-session so the returned
# id_token has the web client as a valid audience — the backend accepts both.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxx.apps.googleusercontent.com
