{
  "expo": {
    "name": "Iron Protocol",
    "slug": "iron-protocol",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ironprotocol",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#18181b",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.danieldeboskey.ironprotocol",
      "infoPlist": {
        "NSHealthShareUsageDescription": "Iron Protocol uses your health data to optimize your training readiness and auto-regulate workout intensity.",
        "NSHealthUpdateUsageDescription": "Iron Protocol records your workout data to Apple Health.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.REPLACE_WITH_REVERSED_IOS_CLIENT_ID"
            ]
          }
        ]
      },
      "entitlements": {
        "com.apple.developer.healthkit": true
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser"
    ]
  }
}
