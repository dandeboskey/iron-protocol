{
  "expo": {
    "name": "Iron Protocol",
    "slug": "iron-protocol",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ironprotocol",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#18181b",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.danieldeboskey.ironprotocol",
      "infoPlist": {
        "NSHealthShareUsageDescription": "Iron Protocol uses your health data to optimize your training readiness and auto-regulate workout intensity.",
        "NSHealthUpdateUsageDescription": "Iron Protocol records your workout data to Apple Health.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.236745855254-4mkb5gklol3carpt1kiisqcd81od60hp"
            ]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.healthkit": true
      },
      "runtimeVersion": "1.0.0"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "3248d991-ca05-4398-a028-ddad40a7a1db"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/3248d991-ca05-4398-a028-ddad40a7a1db"
    },
    "android": {
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "owner": "jddebosk"
  }
}
